# development | production (produccion: sin /docs, cookies Secure, HSTS, seed sin contrasenas fijas)
APP_ENV=development

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=gestasys
DB_USER=gestasys_app
DB_PASSWORD=tu_password

DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=tu_password

# Obligatorio, minimo 32 caracteres: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

COOKIE_SECURE=false
COOKIE_SAMESITE=lax

CORS_ORIGINS=http://localhost:3000
TRUSTED_PROXIES=127.0.0.1,::1

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT=10

IMPORT_MAX_MB=10

BACKUP_DIR=backups
BACKUP_AUTO=true
BACKUP_HOUR=2
BACKUP_MINUTE=0
BACKUP_KEEP=14
PG_DUMP_PATH=pg_dump
