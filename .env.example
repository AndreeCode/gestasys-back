# development | production (produccion: sin /docs, cookies Secure, HSTS, seed sin contrasenas fijas)
APP_ENV=development

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=gestasys
DB_USER=gestasys_app
DB_PASSWORD=tu_password
# disable | prefer | require | verify-ca | verify-full (produccion con BD remota: require o mas)
DB_SSLMODE=prefer

DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=tu_password

# Obligatorio, minimo 32 caracteres: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# HMAC de la cadena de hashes de audit_log (obligatoria en produccion, minimo 32 caracteres).
# Sin ella, en desarrollo se deriva de JWT_SECRET. NO la cambies despues: la cadena existente dejaria de verificar.
AUDIT_CHAIN_KEY=

COOKIE_SECURE=false
COOKIE_SAMESITE=lax

CORS_ORIGINS=http://localhost:3000
TRUSTED_PROXIES=127.0.0.1,::1

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT=10

IMPORT_MAX_MB=10

BACKUP_DIR=backups
# AES-256-GCM, obligatorio en produccion: python -m scripts.backup_key --generate
# Guardala fuera del servidor: sin ella los backups no se pueden restaurar.
BACKUP_ENCRYPTION_KEY=
BACKUP_AUTO=true
BACKUP_HOUR=2
BACKUP_MINUTE=0
BACKUP_KEEP=14
PG_DUMP_PATH=pg_dump
